# --- AI providers (study server functions) ---
# At least ONE of the following must be set, otherwise AI calls fail with
# "AI is not configured yet." They are tried in this order:
#   Gemini (GEMINI_API_KEY) -> Grok / xAI (GROK_API_KEY or XAI_API_KEY)
#   -> Groq (GROQ_API_KEY) -> Lovable gateway (LOVABLE_API_KEY, injected by Lovable).
# Set whichever you have; the request falls through to the next until one answers.
# NOTE: put real secrets in .env.local (gitignored), not here — this file is
# committed. Both old (AIza...) and new (AQ....) Google AI Studio keys work.
GEMINI_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
