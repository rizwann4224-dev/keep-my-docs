# Study Desk — environment template
#
# Copy to `.env.local` (gitignored, wins over `.env`) for local development, or
# set the same names in your deployment's secret store. Values left blank are
# ignored — never commit a real key.

# ---------------------------------------------------------------------------
# AI provider (marking, ask, exam setting, OCR)
# ---------------------------------------------------------------------------
# Personal Google AI Studio key. Tried FIRST on every request, so a shared
# gateway quota never blocks your own notebook. Free key: https://aistudio.google.com/apikey
# Old (AIza…) and new (AQ.…) AI Studio keys both work.
GEMINI_API_KEY=

# Optional: pin the model every Gemini chain leads with (bare id, e.g.
# gemini-3.6-flash or gemini-3.1-pro-preview). Unset = the app's default chain.
# The rest of the chain stays as fallback, so a retired id degrades instead of failing.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Supabase (auth, private notebooks, document storage)
# ---------------------------------------------------------------------------
# Project URL and the publishable (anon) client key — these are safe to expose to
# the browser ONLY because every table is protected by row-level security:
# a key can never read another user's documents. Secret keys never belong here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Safety switches
# ---------------------------------------------------------------------------
# Anonymous access to POST /api/public/icap (used by the public /icap tool).
# FALSE BY DEFAULT: an unauthenticated endpoint that spends the project's AI
# allowance can be drained by a stranger, so it stays closed until a deployment
# opts in with ENABLE_PUBLIC_ICAP=true. Signed-in notebook traffic never needs it.
ENABLE_PUBLIC_ICAP=false

# Never move a request onto a metered endpoint behind the user's back when a
# quota error (HTTP 402) arrives. Leave this false: a quota failure is reported
# as a quota failure and nothing is auto-purchased.
ENABLE_PAID_FALLBACK=false

# ---------------------------------------------------------------------------
# Optional personal fallbacks (used only while GEMINI_API_KEY is unavailable or
# exhausted; each one is reported by name when it fails, and never auto-charged)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
LOVABLE_API_KEY=

# Advanced: override how deep the model thinks (low|medium|high|xhigh|off).
# Marking and challenges default to the deepest tier.
STUDY_REASONING_EFFORT=
